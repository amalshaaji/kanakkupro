# Template only. Replace placeholders in your deployment secret manager.
DJANGO_SETTINGS_MODULE=config.settings.production
APP_ENV=production
SECRET_KEY=replace-with-a-generated-secret-at-least-50-characters-long
ALLOWED_HOSTS=erp.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=replace-with-provider-smtp-host
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=KankkuPro <replace-with-verified-sender@example.com>
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# First key encrypts; remaining comma-separated keys allow staged rotation.
MFA_ENCRYPTION_KEYS=replace-with-generated-fernet-key
DATABASE_CACHE_TABLE=django_cache
AUTH_CACHE_MAX_ENTRIES=100000
CSRF_TRUSTED_ORIGINS=https://erp.example.com
# Enable only after verifying that your controlled proxy strips and sets it.
TRUST_X_FORWARDED_PROTO=False
# Raise after verifying HTTPS for the production domain. Preload remains off.
SECURE_HSTS_SECONDS=0
