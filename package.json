{
  "name": "kanakkupro-assets",
  "private": true,
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./assets/css/input.css -o ./static/css/app.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./assets/css/input.css -o ./static/css/app.css --watch",
    "build:vendor": "mkdir -p static/vendor && cp node_modules/htmx.org/dist/htmx.min.js static/vendor/htmx.min.js",
    "build": "npm run build:css && npm run build:vendor"
  },
  "dependencies": {
    "daisyui": "^5.0.0",
    "htmx.org": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
