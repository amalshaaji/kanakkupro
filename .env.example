DEBUG=True
SECRET_KEY=replace-with-a-random-local-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Use a Neon connection string with sslmode=require for hosted databases.
# For Neon pooled endpoints, use the hostname containing -pooler.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DEFAULT_FROM_EMAIL=KankkuPro <noreply@example.com>
TENANT_INVITATION_TTL_DAYS=7
# Local development defaults to Django's console email backend.
# Set these in the deployment environment for SMTP delivery:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=replace-with-smtp-user
# EMAIL_HOST_PASSWORD=replace-with-smtp-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
